# Copy this file to .env and fill in real values. Never commit .env itself.

# From your Neon project dashboard (Connection Details)
DATABASE_URL="DB link"

PORT=5000

# Used later in Phase 2 for signing JWTs - generate a long random string
JWT_SECRET="replace-this-with-a-long-random-string"
ALLOWED_ORIGINS=http://localhost:5173

UPSTASH_REDIS_REST_URL=https://your-db-name.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token-here